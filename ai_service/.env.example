# AI 服务配置示例（无真实密钥）
PW_DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/personal_website

# LLM 降级链模式（默认）：qwen → zhipu → deepseek 自动降级
PW_LLM_PROVIDER=fallback
PW_FALLBACK_CHAIN=qwen,zhipu,opencode,deepseek
PW_MODELSCOPE_API_KEY=your_modelscope_access_token
PW_MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1

# Qwen (ModelScope，默认首选)
PW_QWEN_MODEL=Qwen/Qwen3.5-35B-A3B

# ZhipuAI GLM (ModelScope，Qwen 降级备用)
PW_ZHIPU_MODEL=ZhipuAI/GLM-5.2

# DeepSeek 独立 API（降级链最后一环）
PW_DEEPSEEK_API_KEY=your_deepseek_api_key
PW_DEEPSEEK_MODEL=deepseek-chat
PW_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenCode 网关（OpenAI 兼容）。⚠️ 两个端点互不相通，模型不通用：
#   https://opencode.ai/zen/v1     免费层 + Zen 按量余额（免费层需 X-Session-Id 头，
#                                  客户端已内置注入；余额错误为 CreditsError）
#   https://opencode.ai/zen/go/v1  Go 订阅（$10/月，24 个开源模型，按美元额度计）
# 切换端点与模型只需改下面两行。
#   Go 主要模型：glm-5.3-flash（$0.15/$0.50）/ glm-5.3 / deepseek-v4-pro / qwen3.6-plus
#               kimi-k3 / minimax-m3 / minimax-m2.7 / qwen3.5-plus
#   免费层模型：nemotron-3.5-lightning-free / nemotron-3-ultra-free（实测可用）
#               mimo-v2.5-free（配额易耗尽）/ deepseek-v4-flash-free（上游常不可用）
PW_OPENCODE_API_KEY=your_opencode_key
PW_OPENCODE_MODEL=glm-5.3-flash
PW_OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# ModelScope 兼容旧配置
PW_MODELSCOPE_MODEL=deepseek-ai/DeepSeek-V4-Pro

# 嵌入模型（ModelScope 云端，bge-m3 1024 维）
PW_EMBEDDING_API_KEY=your_modelscope_access_token
PW_EMBEDDING_BASE_URL=https://ms-ens-xxxx.api-inference.modelscope.cn/v1
PW_EMBEDDING_MODEL=OllmOne/bge-m3-GGUF

# JWT 登录（module-032）：HS256 共享密钥，与 Java application.yml 的 jwt.secret 同值
# 缺失时服务启动 fail-fast（plan §3.4）
PW_JWT_SECRET=your_shared_jwt_secret
